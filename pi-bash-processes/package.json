    "pi-tool-renderer": "*"
  },
  "files": [
    "extensions/",
    "assets/",
    "scripts/",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
