{
  "name": "pi-tool-renderer",
  "version": "2.0.9",
  "description": "Compact Claude/opencode-style renderers for Pi tools with rich diffs, apply_patch, generic/MCP rendering, and optional global chrome.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "tools",
    "renderer",
    "shiki",
    "diff",
    "mcp",
    "apply-patch"
  ],
  "pi": {
    "extensions": [
      "./extensions/tool-renderer.ts"
    ]
  },
  "scripts": {
    "test": "bun test ./extensions/__tests__"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.1",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "README.md",
    "assets/",
    "extensions/",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "exports": {
    ".": "./extensions/tool-renderer.ts",
    "./managed-bash": "./extensions/tool-renderer/managed-bash.ts",
    "./intent": "./extensions/tool-renderer/intent.ts"
  }
}
