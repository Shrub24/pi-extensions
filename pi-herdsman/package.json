{
  "name": "pi-herdsman",
  "version": "0.18.0",
  "type": "module",
  "description": "Asynchronous Pi subagents and agent fleet orchestration for parallel coding agents with nested delegation, background work, and supervision in tmux, through the Radar daemon.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boadij/pi-herdsman.git"
  },
  "bugs": {
    "url": "https://github.com/boadij/pi-herdsman/issues"
  },
  "homepage": "https://github.com/boadij/pi-herdsman#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "subagent",
    "subagents",
    "agents",
    "ai-agents",
    "coding-agents",
    "coding-agent-orchestration",
    "multi-agent",
    "multi-agent-coding",
    "agent-fleet",
    "parallel-agents",
    "parallel-coding-agents",
    "background-agents",
    "nested-agents",
    "agent-orchestration",
    "orchestration",
    "delegation",
    "supervision",
    "radar",
    "tmux",
    "pi-herdsman"
  ],
  "pi": {
    "extensions": [
      "./extension/index.ts"
    ],
    "skills": [
      "."
    ],
    "image": "https://raw.githubusercontent.com/boadij/pi-herdsman/main/docs/assets/thumbnail.webp"
  },
  "piHerdsman": {
    "runtime": {
      "pi": "1.1.0",
      "radar": {
        "commit": "a0a7f97f40a8fd76c4beb49461e7b25e154acf53",
        "protocol": 2
      }
    }
  },
  "scripts": {
    "test": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "smoke": "node scripts/smoke.mjs",
    "check": "node scripts/check.mjs",
    "package:audit": "node scripts/package-audit.mjs",
    "validate": "npm run check && npm run package:audit",
    "release:check": "npm run validate && npm publish --dry-run --ignore-scripts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "esbuild": "^0.28.2",
    "typebox": "^1.3.7"
  },
  "overrides": {
    "@earendil-works/pi-codemode": "1.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "README.md",
    "SKILL.md",
    "LICENSE",
    "docs",
    "extension"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
